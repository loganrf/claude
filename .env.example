# Copy to .env and fill in what you need. Every variable is optional.
# Credential variables also accept a <NAME>_FILE form pointing at a file.
# Most of these can also be set in the web UI (http://localhost:8765). A
# variable set here wins, and the web UI shows it as "from environment".

# --- Web UI --------------------------------------------------------------------
# Password for the web UI. Without one, the first visit asks you to create it,
# using the setup code printed by `docker compose logs claude`.
# CLAUDE_WEBUI_PASSWORD=
# Serve HTTPS with your own certificate (paths inside the container).
# CLAUDE_WEBUI_TLS_CERT=
# CLAUDE_WEBUI_TLS_KEY=
# Set to 0 to turn the web UI off; `server` then runs Remote Control directly.
# CLAUDE_WEBUI=1

# --- Claude authentication: pick one ---------------------------------------
# 1) Claude Pro/Max/Ultra/Team/Enterprise login (recommended). Enables Remote
#    Control, so the container shows up at claude.ai/code and in the Claude app.
#    Sign in from the web UI, or in the terminal:
#      docker compose run --rm claude login
#    The login is saved in the claude-config volume; nothing goes in this file.
#
# 2) Claude plan, long-lived token from `claude setup-token` (run it anywhere).
#    Model access only: no Remote Control.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# 3) Claude Console API key, billed per use. No Remote Control.
# ANTHROPIC_API_KEY=

# --- GitHub and git ----------------------------------------------------------
# Token for gh and for git over https://github.com (fine-grained PAT recommended).
# GH_TOKEN=
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com
# Clone this repository into /workspace on first start (when it's empty).
# GIT_REPO_URL=https://github.com/you/project.git
# GIT_REPO_BRANCH=

# --- Behaviour ---------------------------------------------------------------
# Permission mode: default | acceptEdits | auto | plan | dontAsk | bypassPermissions
# CLAUDE_PERMISSION_MODE=acceptEdits
# Set to 0 to keep the container off claude.ai/code even when logged in.
# CLAUDE_REMOTE_CONTROL=1
# Remote Control session name, and how new sessions are created:
# same-dir | worktree (needs a git repo) | session (single session)
# CLAUDE_RC_NAME=
# CLAUDE_RC_SPAWN=same-dir
# Extra arguments for claude / claude remote-control.
# CLAUDE_ARGS=
# Give the sandbox user passwordless sudo (e.g. to apt-get install).
# CLAUDE_SUDO=0
# Run as this UID/GID (default: owner of the mounted workspace).
# HOST_UID=
# HOST_GID=

# --- Compose only --------------------------------------------------------------
# Docker inside the sandbox: include compose.docker.yaml in every `docker compose`
# command. It runs the container privileged; read its header first.
# COMPOSE_FILE=compose.yaml:compose.docker.yaml
# Host port for the web UI; 127.0.0.1:8765 accepts connections from this machine only.
# CLAUDE_SANDBOX_WEBUI_PORT=8765
# Host folder mounted at /workspace.
# WORKSPACE=./workspace
# CLAUDE_SANDBOX_IMAGE=ghcr.io/loganrf/claude:latest
# CLAUDE_SANDBOX_HOSTNAME=claude-sandbox
